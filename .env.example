# Server-only variables (Vercel → Settings → Environment Variables). Never prefix them with VITE_.
DEEPSEEK_API_KEY=
# Optional: override the DeepSeek model id (default: deepseek-flash)
DEEPSEEK_MODEL=
# Injected by the Upstash for Redis integration (Vercel Marketplace). UPSTASH_REDIS_REST_URL/TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
